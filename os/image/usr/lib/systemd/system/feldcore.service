[Unit]
Description=FELDCORE
Documentation=https://github.com/Herculade0/FELDCORE
After=network-online.target feldcore-state.service
Wants=network-online.target
RequiresMountsFor=/var/lib/feldcore

[Service]
Type=simple
ExecStart=/usr/bin/feldcored
Environment=FELDCORE_DATA_DIR=/var/lib/feldcore
Restart=on-failure
RestartSec=2
# stdout stays in the journal. journald forwards that to ttyS0 only, so
# the setup-code line does not paint over the tty1 login banner.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
