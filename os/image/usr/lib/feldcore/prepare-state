#!/bin/bash
# The state partition is already mounted. Docker and containerd keep their
# data here. /etc is overlaid so host configuration survives the read-only
# root. /var/lib/samba and /var/lib/nfs are bind-mounted because they are
# not under /etc.
set -euo pipefail

modprobe overlay 2>/dev/null || true

base=/var/lib/feldcore
# mnt is the source of the early /mnt/feldcore bind. The mount unit creates
# it before local-fs; this only recreates it if that directory was removed.
mkdir -p \
	"${base}/sysexts" \
	"${base}/updates/incoming" \
	"${base}/docker" \
	"${base}/containerd" \
	"${base}/libvirt" \
	"${base}/cdi" \
	"${base}/mounts" \
	"${base}/mnt" \
	"${base}/etc-upper" \
	"${base}/etc-work" \
	"${base}/var/samba" \
	"${base}/var/nfs"

if [[ ! -e /var/lib/extensions ]]; then
	ln -s "${base}/sysexts" /var/lib/extensions
fi
mkdir -p /var/lib/libvirt

if ! mountpoint -q /etc; then
	find "${base}/etc-work" -mindepth 1 -delete 2>/dev/null || true
	mount -t overlay overlay \
		-o "lowerdir=/etc,upperdir=${base}/etc-upper,workdir=${base}/etc-work" \
		/etc
fi

bind_state() {
	local name=$1
	local src=/var/lib/${name}
	local dest=${base}/var/${name}
	mkdir -p "${src}" "${dest}"
	if [[ -z $(find "${dest}" -mindepth 1 -print -quit 2>/dev/null) ]]; then
		cp -a "${src}/." "${dest}/" 2>/dev/null || true
	fi
	if ! mountpoint -q "${src}"; then
		mount --bind "${dest}" "${src}"
	fi
}

bind_state samba
bind_state nfs

if [[ -f /etc/hostname ]]; then
	name=$(tr -d '[:space:]' </etc/hostname)
	if [[ -n ${name} ]]; then
		# /etc/hostname lives in the overlay mounted just above. PID1 already
		# set the running (transient) hostname from the image's lower /etc at
		# early boot, before this overlay existed, so set-hostname --static on
		# its own leaves gethostname()/uname — and /api/v1/system/info — stuck
		# on the image default. Set the running name too.
		hostname "${name}" || true
		hostnamectl set-hostname --static "${name}" || true
	fi
fi

# The overlay can also carry fstab lines the wizard added for a data disk.
# systemd-fstab-generator read the image's lower /etc/fstab at early boot,
# before this overlay existed, so those mounts were never set up. Honour them
# now. Every FELDCORE fstab line is nofail, so a missing disk is not fatal.
mount -a || true

if command -v systemd-sysext >/dev/null 2>&1; then
	systemd-sysext refresh || true
fi
systemctl daemon-reload || true
systemctl try-reload-or-restart systemd-networkd.service || true
