#!/bin/sh
# Copy the modules the live initramfs needs to see the installer medium.
set -e

PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs)
	prereqs
	exit 0
	;;
esac

. /usr/share/initramfs-tools/hook-functions

manual_add_modules squashfs isofs vfat exfat nls_cp437 nls_ascii nls_utf8 usb_storage uas loop

copy_exec /sbin/blkid || copy_exec /usr/sbin/blkid
copy_exec /sbin/losetup || copy_exec /usr/sbin/losetup
copy_exec /bin/mount || copy_exec /usr/bin/mount
copy_exec /bin/umount || copy_exec /usr/bin/umount
